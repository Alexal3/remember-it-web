<div id="profile-modal" class="modal modal-fixed-footer">
  <div class="modal-content">
    <div class="container">

      <h4 class="center-align">Настройки профиля</h4>

      <p>&nbsp;</p>

      <div class="center-align">
        {{#if avatarURL}}
          <img id="avatar_profile" class="avatar" src="{{avatarURL}}">
        {{else}}
          <img id="avatar_profile" class="avatar" src="/male.png">
        {{/if}}
      </div>
      <div class="file-field input-field">
        <div class="btn blue accent-2 waves-effect waves-light">
          <span>Загрузить</span>
          <input type="file" id="input_new_avatar">
        </div>
        <div class="file-path-wrapper">
          <input class="file-path validate" type="text" placeholder="Загрузить новый аватар">
        </div>
      </div>
      <p class="bold-font">Картинка должна иметь формат PNG, JPG или JPEG и не превышать 2 МБ.</p>
      <div id="avatar_progress" class="progress progress-color hide">
        <div class="indeterminate blue lighten-1"></div>
      </div>
      <button id="btn_save_avatar" class="blue accent-2 btn waves-effect waves-light">Сохранить</button>
      {{#if avatarURL}}
        <button id="btn_delete_avatar" class="blue accent-2 btn waves-effect waves-light">Удалить аватар</button>
      {{else}}
        <button id="btn_delete_avatar" class="blue accent-2 btn waves-effect waves-light disabled">Удалить аватар</button>
      {{/if}}

      <p>&nbsp;</p>

      <p class="bold-font">Ваша почта - {{email}}</p>
      <div class="input-field">
        <input id="email" type="email" name="email" class="validate">
        <label for="email">Новый адрес эл. почты</label>
      </div>
      <p class="bold-font"><span class="color-red">Внимание!</span> Проверьте адрес введенной почты. Не ошибитесь, чтобы посторонний человек не получил доступ к вашему аккаунту.</p>
      <div id="email_progress" class="progress progress-color hide">
        <div class="indeterminate blue lighten-1"></div>
      </div>
      <button id="btn_save_email" class="blue accent-2 btn waves-effect waves-light">Сохранить</button>

      <p>&nbsp;</p>

      <p class="bold-font">Изменить пароль</p>
      <div class="input-field">
        <input id="old_password" type="password" name="oldPassword" class="validate">
        <label for="old_password">Старый пароль</label>
      </div>
      <div class="input-field">
        <input id="new_password" type="password" name="newPassword" class="validate">
        <label for="new_password">Новый пароль</label>
      </div>
      <div class="input-field">
        <input id="confirm_password" type="password" name="confirmPassword" class="validate">
        <label for="confirm_password">Подтвердите пароль</label>
      </div>
      <div id="password_progress" class="progress progress-color hide">
        <div class="indeterminate blue lighten-1"></div>
      </div>
      <button id="btn_save_password" class="blue accent-2 btn waves-effect waves-light">Сохранить</button>

      <input type="hidden" name="userId" value="{{userId}}">

    </div>
  </div>
  <div class="modal-footer">
    <div class="container">
      <button class="modal-close waves-effect waves-light blue accent-2 btn">Готово</button>
      {{!-- <div class="preloader-wrapper small active left">
        <div class="spinner-layer spinner-blue-only">
          <div class="circle-clipper left">
            <div class="circle"></div>
          </div>
          <div class="gap-patch">
            <div class="circle"></div>
          </div>
          <div class="circle-clipper right">
            <div class="circle"></div>
          </div>
        </div>
      </div> --}}
      {{!-- <button class="modal-close waves-effect waves-light blue accent-2 btn">Сохранить</button> --}}
    </div>
  </div>
</div>