<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="{{csrf}}">
  <title>Remember it! - заметки онлайн</title>
  <link rel="stylesheet" href="/index.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="blue">
  <div class="navbar-fixed">
    <nav class="blue darken-4">
      <div class="nav-wrapper">
        <a href="http://alexal3.com" class="right brand-logo"><img src="/logo2.png"></a>
        <ul class="left">
          <li><a class="waves-effect waves-light btn blue accent-2" href="/">На главную</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <main>
    <div class="row">
      <div class="col s12 m6 l6 xl6 offset-m3 offset-l3 offset-xl3">
        <div class="container">

          {{#unless error}}

            <div class="card hoverable">
              <div class="card-content">
                <h4 class="center-align">Восстановление пароля</h4>
                <p class="userSelectNone">&nbsp;</p>
                <div class="input-field">
                  <input id="password" type="password" name="password" class="validate">
                  <label for="password">Пароль</label>
                </div>
                <div class="input-field">
                  <input id="password_confirm" type="password" name="passwordConfirm" class="validate">
                  <label for="password_confirm">Подтвердите пароль</label>
                </div>
                <input type="hidden" name="userId" value="{{userId}}">
                <input type="hidden" name="token" value="{{token}}">
              </div>
              <div class="card-action">
                <button class="btn-reset-password-done waves-effect waves-light blue accent-2 btn">Готово!</button>
              </div>
            </div>

          {{else}}
            <div class="alert">{{error}}</div>
          {{/unless}}

        </div>
      </div>
    </div>
  </main>

  <script src="/reg-login-scripts.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>