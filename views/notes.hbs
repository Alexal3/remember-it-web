<div class="row">
  <div class="col s12">
    <div id="create_note_panel" class="card hoverable">
      <div class="card-content">
        <div class="input-field">
          <input id="create_note_title" type="text">
          <label for="create_note_title">Заголовок</label>
        </div>
        <div class="input-field">
          <textarea id="create_note" class="materialize-textarea"></textarea>
          <label for="create_note">Не забыть сделать...</label>
        </div>
      </div>
      <div class="card-action">
        <button class="btn-new-note-done waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">done</i></button>
      </div>
    </div>
  </div>
</div>

<div id="notes-container" class="row">

  {{#if notes.length}}
    {{#each notes}}
      <div class="col xl6">
        <div class="note card hoverable" id="card-id-{{id}}">
          <div class="card-content">
            <span class="card-title">{{title}}</span>
            <p>{{body}}</p>
            <input type="hidden" name="id" value="{{id}}">
            <input type="hidden" name="page" value="notes">
            <input type="hidden" name="archived" value="false">
            <div class="input-field hide">
              <input name="title" id="note_title_edit_{{id}}" type="text" value="{{title}}">
              <label for="note_title_edit_{{id}}"></label>
            </div>
            <div class="input-field hide">
              <textarea name="body" id="note_content_edit_{{id}}" class="materialize-textarea">{{body}}</textarea>
              <label for="note_content_edit_{{id}}"></label>
            </div>
            <span class="empty_note_text grey-text hide">Пустая заметка</span>
          </div>
          <div class="card-action">
            <button class="btn-done waves-effect btn-flat hide"><i class="material-icons blue-text text-accent-2">done</i></button>
            <button type="button" class="btn-cancel waves-effect btn-flat hide" onclick="notesCancelEdit('{{id}}')"><i class="material-icons blue-text text-accent-2">cancel</i></button>
            <button type="button" class="btn-edit waves-effect btn-flat" onclick="notesStartEdit('{{id}}')"><i class="material-icons blue-text text-accent-2">edit</i></button>
            <button name="toArchive" value="true" class="btn-archive waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">archive</i></button>
            <button name="toDelete" value="true" class="btn-delete waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">delete</i></button>
          </div>
        </div>
      </div>
    {{/each}}
  {{else}}
    <div class="col s12 l6 offset-l3">
      <div class="card-panel center-align">Создайте вашу первую заметку!</div>
    </div>
  {{/if}}

</div>

