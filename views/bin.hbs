<div class="row">
  <div class="col s12 l6 offset-l3">
    <div id="clear_bin_panel" class="card-panel center-align">
      <p>Заметки хранятся 7 дней, после чего удаляются.</p>
      <button class="btn-clear-bin waves-effect waves-light btn blue accent-2">Очистить корзину</button>
    </div>
  </div>
</div>

<div id="notes-container" class="row">
  <div class="col s12">

    {{#if notes.length}}
      {{#each notes}}
        <div class="note card hoverable">
          <div class="card-content">
            <span class="card-title">{{title}}</span>
            <p>{{body}}</p>
            <input type="hidden" name="archived" value="{{archived}}">
            <input type="hidden" name="title" value="{{title}}">
            <input type="hidden" name="body" value="{{body}}">
            <input type="hidden" name="id" value="{{id}}">
            <input type="hidden" name="page" value="bin">
            <span class="empty_note_text grey-text hide">Пустая заметка</span>
          </div>
          <div class="card-action">
            <button name="toDeleteForever" value="true" class="btn-delete-forever waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">delete_forever</i></button>
            <button name="toRestore" value="true" class="btn-restore waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">restore</i></button>
          </div>
        </div>
      {{/each}}
      <div class="col s12 l6 offset-l3 hide" id="card_with_title_bin_is_empty">
        <div class="card-panel center-align">Корзина пуста</div>
      </div>
    {{else}}
      <div class="col s12 l6 offset-l3" id="card_with_title_bin_is_empty">
        <div class="card-panel center-align">Корзина пуста</div>
      </div>
    {{/if}}

  </div>
</div>