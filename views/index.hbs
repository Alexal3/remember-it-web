<!DOCTYPE html>
<html lang="ru" class="index-html-tag">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="{{csrf}}">
  <title>Remember it! - заметки онлайн</title>
  <link rel="stylesheet" href="index.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body>
  <div class="navbar-fixed index-navbar-fixed-tag">
    <nav class="blue darken-4">
      <div class="nav-wrapper">
        <a href="http://alexal3.com" class="right brand-logo"><img src="logo2.png"></a>
        <ul class="left">
          <li><a class="waves-effect waves-light btn blue accent-2 modal-trigger" href="#register-modal">Регистрация</a></li>
          <li><a class="waves-effect waves-light btn blue accent-2 modal-trigger" href="#login-modal">Вход</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <main>
    <div class="row">
      <div class="col s12 m12 l6 xl6 blue landing-right-part valign-wrapper">
        <div class="container">
          <h3>Просто попробуйте!</h3>

          <p class="userSelectNone">&nbsp;</p>

          <div class="card hoverable">
            <div class="card-content">
              <div class="input-field">
                <input  id="create_note_title" type="text" maxlength="100">
                <label for="create_note_title">Заголовок</label>
              </div>
              <div class="input-field">
                <textarea id="create_note" class="materialize-textarea" maxlength="800"></textarea>
                <label for="create_note">Не забыть сделать...</label>
              </div>
            </div>
            <div class="card-action">
              <button id="button_create_note_example" class="waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">done</i></button>
            </div>
          </div>
          
          <div id="note_example" class="card hoverable hide">
            <div class="card-content">
              <span class="card-title"></span>
              <p></p>
              <div class="input-field hide">
                <input id="note_title_example" type="text">
                <label for="note_title_example"></label>
              </div>
              <div class="input-field hide">
                <textarea id="note_content_example" class="materialize-textarea"></textarea>
                <label for="note_content_example"></label>
              </div>
              <span class="empty_note_text grey-text hide">Пустая заметка</span>
            </div>
            <div class="card-action">
              <button id="note_example_done" class="waves-effect btn-flat hide"><i class="material-icons blue-text text-accent-2">done</i></button>
              <button id="note_example_cancel" class="waves-effect btn-flat hide"><i class="material-icons blue-text text-accent-2">cancel</i></button>
              <button id="note_example_edit" class="waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">edit</i></button>
              <button id="note_example_delete" class="waves-effect btn-flat"><i class="material-icons blue-text text-accent-2">delete</i></button>
            </div>
          </div>
        </div>
      </div>

      <div class="col s12 m12 l6 xl6 blue lighten-2 landing-left-part valign-wrapper">
        <div class="container">
          <h3>Нравится?</h3>

          <p class="userSelectNone">&nbsp;</p>
          
          <div class="userSelectNone">
            <button class="waves-effect waves-light btn blue accent-2 modal-trigger" href="#register-modal">Регистрация</button>
            <button class="waves-effect waves-light btn blue accent-2 modal-trigger btn-login-in-landing" href="#login-modal">Вход</button>
          </div>

          <p class="bold-font"><span class="color-red">Внимние!</span> Все сообщения электронной почты, отправленные с этого демо приходят ТОЛЬКО на следующую почту:</p>
          <ul class="bold-font">
            <li>Почта - davonte.ziemann13@ethereal.email</li>
            <li>Пароль - N1uqxvPeXG4PMQXYrw</li>
            <li>Адрес для входа - https://ethereal.email/login</li>
          </ul>
        </div>
      </div>
    </div>
  </main>

  <div id="register-modal" class="modal">
    <div class="modal-content">
      <div class="container">
        <h4 class="center-align">Регистрация</h4>
        <p class="userSelectNone">&nbsp;</p>
        <div class="input-field">
          <input id="reg_email" type="email" name="email" class="validate">
          <label for="reg_email">Адрес эл. почты</label>
        </div>
        <div class="input-field">
          <input id="reg_password" type="password" name="password" class="validate">
          <label for="reg_password">Пароль</label>
        </div>
        <div class="input-field">
          <input id="reg_password_confirm" type="password" name="passwordConfirm" class="validate">
          <label for="reg_password_confirm">Подтвердите пароль</label>
        </div>
        <input type="hidden" name="_csrf" value="{{csrf}}">
      </div>
    </div>
    <div class="modal-footer">
      <div class="container">
        <button class="btn-reg modal-close waves-effect waves-light blue accent-2 btn">Готово!</button>
      </div>
    </div>
  </div>

  <div id="login-modal" class="modal">
    <div class="modal-content">
      <div class="container">
        <h4 class="center-align">Вход</h4>
        <p class="userSelectNone">&nbsp;</p>
        <div class="input-field">
          <input id="login_email" type="email" name="email" class="validate">
          <label for="login_email">Адрес эл. почты</label>
        </div>
        <div class="input-field">
          <input id="login_password" type="password" name="password" class="validate">
          <label for="login_password">Пароль</label>
        </div>
        <input type="hidden" name="_csrf" value="{{csrf}}">
      </div>
    </div>
    <div class="modal-footer">
      <div class="container">
        <button class="btn-forgot-password waves-effect btn-flat modal-trigger" href="#forgot-password">Забыли пароль?</button>
        <button class="btn-login modal-close waves-effect waves-light blue accent-2 btn">Готово!</button>
      </div>
    </div>
  </div>

  <div class="modal" id="forgot-password">
    <div class="modal-content">
      <div class="container">
        <h4 class="center-align">Сброс пароля</h4>
        <p class="userSelectNone">&nbsp;</p>
        <div class="input-field">
          <input id="reset_password_email" type="email" name="email" class="validate">
          <label for="reset_password_email">Адрес эл. почты</label>
        </div>
        <input type="hidden" name="_csrf" value="{{csrf}}">
      </div>
    </div>
    <div class="modal-footer">
      <div class="container">
        <button class="btn-reset-password modal-close waves-effect waves-light blue accent-2 btn">Сбросить</button>
      </div>
    </div>
  </div>

  <script src="notes-example.js"></script>
  <script src="reg-login-scripts.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('.modal');
      var instances = M.Modal.init(elems);
    });
  </script>
</body>
</html>